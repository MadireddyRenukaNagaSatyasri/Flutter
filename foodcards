
import 'package:flutter/material.dart';

void main() {
  runApp(
    MaterialApp(
      debugShowCheckedModeBanner: false,
      home: FoodScreen(),
    ),
  );
}


// Custom Widget
class FoodCard extends StatefulWidget {

  final IconData icon;
  final String name;
  final String price;
  final String details;

  FoodCard({
    required this.icon,
    required this.name,
    required this.price,
    required this.details,
  });

  @override
  State<FoodCard> createState() {
    return _FoodCardState();
  }
}


// Food Card State
class _FoodCardState extends State<FoodCard> {

  bool showDetails = false;

  @override
  Widget build(BuildContext context) {

    return Card(
      margin: EdgeInsets.symmetric(
        horizontal: 15,
        vertical: 10,
      ),

      elevation: 5,

      child: Container(
        width: double.infinity,

        padding: EdgeInsets.all(15),

        child: Column(
          children: [

            // Food Icon
            Icon(
              widget.icon,
              size: 80,
              color: Colors.orange,
            ),

            SizedBox(height: 10),

            // Food Name
            Text(
              widget.name,
              style: TextStyle(
                fontSize: 22,
                fontWeight: FontWeight.bold,
              ),
            ),

            SizedBox(height: 5),

            // Price
            Text(
              widget.price,
              style: TextStyle(
                fontSize: 18,
              ),
            ),

            SizedBox(height: 10),

            // Details
            if (showDetails)
              Container(
                width: double.infinity,

                padding: EdgeInsets.all(10),

                color: Colors.orange.shade50,

                child: Text(
                  widget.details,
                  textAlign: TextAlign.center,

                  style: TextStyle(
                    fontSize: 16,
                  ),
                ),
              ),

            SizedBox(height: 10),

            // ADD TO CART Button
            ElevatedButton(
              onPressed: () {
                print("${widget.name} added to cart");
              },

              child: Text("ADD TO CART"),
            ),

            // CARD DETAILS Button
            ElevatedButton(
              onPressed: () {

                setState(() {
                  showDetails = !showDetails;
                });

              },

              child: Text(
                showDetails
                    ? "HIDE DETAILS"
                    : "CARD DETAILS",
              ),
            ),
          ],
        ),
      ),
    );
  }
}


// Main Screen
class FoodScreen extends StatelessWidget {

  @override
  Widget build(BuildContext context) {

    return Scaffold(

      // App Bar
      appBar: AppBar(
        title: Text("Food Ordering"),
        centerTitle: true,
        backgroundColor: Colors.orange,
      ),

      // Body
      body: SingleChildScrollView(

        child: Column(
          children: [

            // Pizza
            FoodCard(
              icon: Icons.local_pizza,
              name: "Pizza",
              price: "₹250",
              details:
                  "Delicious cheese pizza with fresh toppings.",
            ),

            // Burger
            FoodCard(
              icon: Icons.fastfood,
              name: "Burger",
              price: "₹150",
              details:
                  "Tasty burger with cheese and fresh vegetables.",
            ),

            // Biryani
            FoodCard(
              icon: Icons.rice_bowl,
              name: "Biryani",
              price: "₹200",
              details:
                  "Spicy and delicious chicken biryani.",
            ),
          ],
        ),
      ),
    );
  }
}

